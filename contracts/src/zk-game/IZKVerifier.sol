pragma solidity ^0.8.28;

/// @notice What every verifier generated from a circuit implements (see
///         contracts/src/verifiers, generated by circuits/scripts/generate.ts).
///         Public inputs are in the order the circuit declares its `pub`
///         parameters, one field element per bytes32.
interface IZKVerifier {
    function verify(
        bytes calldata proof,
        bytes32[] calldata publicInputs
    ) external view returns (bool);
}
